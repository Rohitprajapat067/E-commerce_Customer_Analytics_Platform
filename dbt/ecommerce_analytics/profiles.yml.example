# Copy to profiles.yml (or ~/.dbt/profiles.yml) and fill in credentials.
# In the Docker Compose setup this is generated automatically from env
# vars — see docs/deployment_guide.md.

ecommerce_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PG_HOST', 'localhost') }}"
      port: "{{ env_var('PG_PORT', '5432') | as_number }}"
      user: "{{ env_var('PG_USER', 'analytics_user') }}"
      pass: "{{ env_var('PG_PASSWORD', 'change_me') }}"
      dbname: "{{ env_var('PG_DB', 'ecommerce_analytics') }}"
      schema: staging
      threads: 4
